# SPDX-License-Identifier: GPL-3.0-or-later
# The Raspberry Pi desktop's menu entry: opens Monster in a window. Installed
# to /usr/share/monster-cyberspace/; the app copies it to
# ~/.local/share/applications at each start. TryExec hides it once the
# package is removed.
[Desktop Entry]
Name=Monster for Cyberspace
Comment=A cyberspace.online client
TryExec=/usr/share/APPLaunch/bin/monster-cyberspace
Exec=/usr/share/APPLaunch/bin/monster-cyberspace
Icon=/usr/share/monster-cyberspace/monster-cyberspace.png
Terminal=false
Type=Application
Categories=Network;Chat;
StartupWMClass=monster-cyberspace
